package com.example.monitor.ui;

import com.example.monitor.viewmodel.CpuSeries;
import com.example.monitor.viewmodel.TimeAxis;
import java.util.List;
import javafx.geometry.VPos;
import javafx.scene.canvas.Canvas;
import javafx.scene.canvas.GraphicsContext;
import javafx.scene.layout.Region;
import javafx.scene.text.Font;
import javafx.scene.text.Text;
import javafx.scene.text.TextAlignment;

/** A 0..100% line graph on a Canvas. It only paints what CpuSeries describes. FX thread only. */
final class PercentGraph extends Region {
    private static final double LEFT = 46, RIGHT = 12, TOP = 10, BOTTOM = 24;

    private final Canvas canvas = new Canvas();
    private final Font font = Font.font("Segoe UI", 11);
    private CpuSeries.Series series = CpuSeries.Series.empty(60);
    private String overlay = "";

    PercentGraph() {
        getChildren().add(canvas);
        setMinHeight(140);
        setPrefHeight(260);
    }

    void setSeries(CpuSeries.Series series) {
        this.series = series;
        draw();
    }

    void setOverlay(String text) {
        this.overlay = text == null ? "" : text;
        draw();
    }

    @Override
    protected void layoutChildren() {
        canvas.setWidth(Math.max(0, getWidth()));
        canvas.setHeight(Math.max(0, getHeight()));
        draw();
    }

    private void draw() {
        double w = canvas.getWidth(), h = canvas.getHeight();
        GraphicsContext g = canvas.getGraphicsContext2D();
        g.clearRect(0, 0, w, h);
        g.setFill(Theme.PLOT_BG);
        g.fillRect(0, 0, w, h);
        if (w < 80 || h < 80) return;

        double pw = w - LEFT - RIGHT, ph = h - TOP - BOTTOM;
        double window = series.windowSeconds();
        g.setFont(font);
        g.setLineWidth(1);

        // y axis: gridlines and labels
        g.setTextAlign(TextAlignment.RIGHT);
        g.setTextBaseline(VPos.CENTER);
        for (int pct = 0; pct <= 100; pct += 25) {
            double y = TOP + ph * (1 - pct / 100.0);
            g.setStroke(Theme.GRID);
            g.strokeLine(LEFT, Math.round(y) + 0.5, LEFT + pw, Math.round(y) + 0.5);
            g.setFill(Theme.AXIS_TEXT);
            g.fillText(pct + "%", LEFT - 6, y);
        }

        // x axis: ticks counted back from the newest snapshot
        g.setTextAlign(TextAlignment.CENTER);
        g.setTextBaseline(VPos.TOP);
        for (double ago : TimeAxis.ticks(window)) {
            double x = LEFT + pw * (1 - ago / window);
            g.setStroke(Theme.GRID);
            g.strokeLine(Math.round(x) + 0.5, TOP, Math.round(x) + 0.5, TOP + ph);
            g.setFill(Theme.AXIS_TEXT);
            g.fillText(TimeAxis.formatAgo(ago), x, TOP + ph + 6);
        }

        // data, clipped to the plot area
        g.save();
        g.beginPath();
        g.rect(LEFT, TOP, pw, ph);
        g.clip();
        double base = TOP + ph;
        for (List<CpuSeries.Point> seg : series.segments()) {
            if (seg.size() == 1) {
                g.setFill(Theme.LINE);
                g.fillOval(px(seg.get(0).x(), window, pw) - 2, py(seg.get(0).pct(), ph) - 2, 4, 4);
                continue;
            }
            g.beginPath();
            g.moveTo(px(seg.get(0).x(), window, pw), base);
            for (CpuSeries.Point p : seg) g.lineTo(px(p.x(), window, pw), py(p.pct(), ph));
            g.lineTo(px(seg.get(seg.size() - 1).x(), window, pw), base);
            g.closePath();
            g.setFill(Theme.LINE_FILL);
            g.fill();

            g.beginPath();
            g.moveTo(px(seg.get(0).x(), window, pw), py(seg.get(0).pct(), ph));
            for (int i = 1; i < seg.size(); i++) {
                g.lineTo(px(seg.get(i).x(), window, pw), py(seg.get(i).pct(), ph));
            }
            g.setStroke(Theme.LINE);
            g.setLineWidth(1.6);
            g.stroke();
        }
        g.restore();

        if (!overlay.isEmpty()) drawBanner(g, pw, ph);
    }

    private static double px(double x, double window, double pw) {
        return LEFT + pw * (x + window) / window;
    }

    private static double py(double pct, double ph) {
        return TOP + ph * (1 - pct / 100.0);
    }

    private void drawBanner(GraphicsContext g, double pw, double ph) {
        Text t = new Text(overlay);
        t.setFont(font);
        double bw = t.getLayoutBounds().getWidth() + 28, bh = 26;
        double x = LEFT + (pw - bw) / 2;
        double y = series.isEmpty() ? TOP + (ph - bh) / 2 : TOP + 8;
        g.setFill(Theme.BANNER_BG);
        g.fillRoundRect(x, y, bw, bh, 8, 8);
        g.setStroke(Theme.BANNER_BORDER);
        g.setLineWidth(1);
        g.strokeRoundRect(x, y, bw, bh, 8, 8);
        g.setFill(Theme.BANNER_TEXT);
        g.setTextAlign(TextAlignment.CENTER);
        g.setTextBaseline(VPos.CENTER);
        g.fillText(overlay, x + bw / 2, y + bh / 2);
    }
}
